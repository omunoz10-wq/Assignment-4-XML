<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd = "http://www.w3.org/2001/XMLSchema" xmlns ="https://omunoz10-wq.github.io/Assignment-4-XML" targetNamespace = "https://omunoz10-wq.github.io/Assignment-4-XML" elementFormDefault = "qualified" attributeFormDefault= "unqualified">
  <xs:element name="NationalParks" type="ParksListType"/>

  <xs:complexType name = "ParksListType">
    <xs:sequence>
      <xs:element name = "NationalPark" type = "ParkType" minOccurs ="1" maxOccurs ="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ParkType">
    <xs:sequence>
      <xs:element name ="Name" type = "xs:string" minOccurs = "1" maxOccurs = "1"/>
      <xs:element name ="Phone" type = "xs:string" minOccurs = "1" maxOccurs = "unbounded"/>
      <xs:element name ="Address" type = "AddressType" minOccurs ="1" maxOccurs = "1"/>
    </xs:sequence>
    <xs:attribute name ="Rating" type = "xs:decimal" use="optional"/>
  </xs:complexType>

  <xs:complexType name = "AddressType">
    <xs:sequence>
      <xs:element name ="Number" type = "xs:int" minOccurs = "1" maxOccurs="1"/>
      <xs:element name = "Street" type = "xs:string" minOccurs = "1" maxOccurs="1"/>
      <xs:element name ="City" type= "xs:string" minOccurs = "1" maxOccurs="1"/>
      <xs:element name = "State" type ="xs:string" minOccurs = "1" maxOccurs="1"/>
      <xs:element name = "Zip" type = "xs:string" minOccurs = "1" maxOccurs = "1"/>
    </xs:sequence>
    <xs:attribute name = "NearestAirport" type = "xs:string" use = "required"/>
  </xs:complexType>
</xs:schema>
